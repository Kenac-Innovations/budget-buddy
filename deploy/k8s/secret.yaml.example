# Do not commit a populated Secret. Supply through Kenac's secret manager.
apiVersion: v1
kind: Secret
metadata:
  name: budget-buddy-env
  namespace: budget-buddy
type: Opaque
stringData:
  ADVISOR_MODE: live
  OPENAI_MODEL: gpt-6.1 # Confirm the model ID in the API account.
  OPENAI_API_KEY: REPLACE_FROM_SECRET_MANAGER
  DATABASE_URL: postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
  APP_URL: https://budget-buddy.REPLACE_DOMAIN
  # Set only after verifying ingress overwrite and blocking direct public pod access.
  TRUSTED_IP_HEADER: x-real-ip
